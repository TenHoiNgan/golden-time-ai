# Cấu hình Dịch vụ AI Golden Time
APP_NAME="Golden Time AI Fruit Intelligence Service"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Cấu hình Mô hình
MODEL_NAME=mobilenet_v3_small
# MODEL_WEIGHTS_PATH=./models/fruit_model.pt
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.25

# Giới hạn ảnh
MAX_IMAGE_SIZE_MB=10

# Khóa bảo mật API (Tùy chọn, để trống nếu không bật Bearer Token)
# Khớp với AI_SERVICE_API_KEY trong cấu hình backend Golden Time
AI_SERVICE_API_KEY=
